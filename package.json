{
	"name": "@wahidgroup/veneer",
	"version": "0.1.0",
	"description": "React component library for Wahid Group apps",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./data-table": {
			"types": "./dist/data-table.d.ts",
			"default": "./dist/data-table.js"
		},
		"./diff": {
			"types": "./dist/diff.d.ts",
			"default": "./dist/diff.js"
		},
		"./flow": {
			"types": "./dist/flow.d.ts",
			"default": "./dist/flow.js"
		},
		"./flow/layout": {
			"types": "./dist/flow-layout.d.ts",
			"default": "./dist/flow-layout.js"
		},
		"./theme.css": "./theme.css",
		"./package.json": "./package.json"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist",
		"theme.css",
		"sbom.json"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"spellcheck": "cspell \"**/*\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke": "node --experimental-strip-types ./scripts/smoke-exports.ts",
		"pack:check": "node --experimental-strip-types ./scripts/check-pack.ts",
		"prepare": "husky",
		"prepublishOnly": "make clean-dist && make build && make sbom",
		"sbom": "cyclonedx-npm --omit dev --package-lock-only --flatten-components --short-PURLs --output-reproducible --output-file sbom.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wahidgroup/veneer.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"license": "MIT",
	"peerDependencies": {
		"@tanstack/react-table": ">=8.21.3 <9",
		"diff": ">=9.0.0 <10",
		"elkjs": ">=0.11.1 <1",
		"react": ">=19",
		"react-dom": ">=19"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-table": {
			"optional": true
		},
		"diff": {
			"optional": true
		},
		"elkjs": {
			"optional": true
		}
	},
	"dependencies": {
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.24.0",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@cyclonedx/cyclonedx-npm": "6.0.0",
		"@tanstack/react-table": "8.21.3",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "24.0.4",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@wahidgroup/lint-rules": "0.1.0",
		"cspell": "9.7.0",
		"diff": "9.0.0",
		"elkjs": "0.11.1",
		"eslint": "9.39.2",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"husky": "9.1.7",
		"jsdom": "28.1.0",
		"prettier": "3.8.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"vitest-axe": "0.1.0"
	}
}
