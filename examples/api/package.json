{
	"name": "@wahidgroup/veneer-examples-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint .",
		"start": "tsx src/main.ts",
		"start:dev": "tsx watch src/main.ts",
		"test": "vitest run",
		"generate-types": "mkdir -p ../src/api/types && openapi-typescript ./openapi.json -o ../src/api/types/api.d.ts",
		"generate-openapi": "tsx src/scripts/export-openapi.ts"
	},
	"dependencies": {
		"@nestjs/common": "11.1.28",
		"@nestjs/core": "11.1.28",
		"@nestjs/platform-express": "11.1.28",
		"@nestjs/platform-ws": "11.1.28",
		"@nestjs/swagger": "11.4.5",
		"@nestjs/websockets": "11.1.28",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@darraghor/eslint-plugin-nestjs-typed": "7.2.4",
		"@types/node": "24.0.4",
		"@types/ws": "8.18.1",
		"@wahidgroup/lint-rules": "0.1.0",
		"eslint": "9.39.2",
		"openapi-typescript": "7.13.0",
		"tsx": "4.23.1",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}
