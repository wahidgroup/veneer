		"contact": {}
	},
	"tags": [],
	"servers": [],
	"components": {
		"schemas": {
			"HealthStatusDto": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"enum": [
							"ok"
						]
					}
				},
				"required": [
					"status"
				]
			},
			"StreamStateDto": {
				"type": "object",
				"properties": {
					"streaming": {
						"type": "boolean"
					}
				},
				"required": [
					"streaming"
				]
			},
			"ResetStateDto": {
				"type": "object",
				"properties": {
					"streaming": {
						"type": "boolean"
					},
					"count": {
						"type": "number"
					}
				},
				"required": [
					"streaming",
					"count"
				]
			},
			"TableRowStatusEnum": {
				"type": "string",
				"enum": [
					"healthy",
					"degraded",
					"down"
				]
			},
			"TableRowDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"region": {
						"type": "string"
					},
					"status": {
						"allOf": [
							{
								"$ref": "#/components/schemas/TableRowStatusEnum"
							}
						]
					},
					"cpu": {
						"type": "number"
					}
				},
				"required": [
					"id",
					"name",
					"region",
					"status",
					"cpu"
				]
			},
			"AddRowsDto": {
				"type": "object",
				"properties": {
					"rows": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/TableRowDto"
						}
					}
				},
				"required": [
					"rows"
				]
			},
			"TableCountDto": {
				"type": "object",
				"properties": {
					"count": {
						"type": "number"
					}
				},
				"required": [
					"count"
				]
			},
			"RemoveRowsDto": {
				"type": "object",
				"properties": {
					"ids": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"required": [
					"ids"
				]
			}
		}
	}
